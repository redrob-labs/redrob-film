<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Redrob Film</string>
  <key>CFBundleName</key>
  <string>Redrob Film</string>
  <key>CFBundleExecutable</key>
  <string>Redrob Film</string>
  <key>CFBundleIdentifier</key>
  <string>ai.redrob.film</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>RedrobFilmVersion</key>
  <string>@VERSION@</string>
  <key>RedrobFilmBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Redrob Film</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Voice-over recording (timeline track header ▸ Voice-over Record) reads the microphone.
       Without this string macOS never asks and the app gets no input. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Redrob Film uses the microphone to record voice-over onto the timeline.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the FilmCraft contributors and Janghoon Lee (Redrob) and contributors. MIT OR Apache-2.0.</string>

  <!-- The project format: .rfilm, plus the pre-rename extension so old projects still open. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.redrob.film.project</string>
      <key>UTTypeDescription</key>
      <string>Redrob Film Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.json</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>Redrob Film</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>rfilm</string><string>fcproj</string></array> <!-- legacy: .fcproj still opens -->
        <key>public.mime-type</key>
        <array><string>application/x-redrob-film</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
